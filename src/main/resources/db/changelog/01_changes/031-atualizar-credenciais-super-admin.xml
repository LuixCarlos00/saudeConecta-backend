<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="031-001-atualizar-credenciais-super-admin" author="equipe-sentinela">
        <!-- Credenciais reais do ROOT saíram do repositório: vêm de ROOT_LOGIN / ROOT_SENHA_HASH
             (spring.liquibase.parameters). ANY mantém válido o checksum dos bancos que já rodaram a versão antiga. -->
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <and>
                <sqlCheck expectedResult="1">SELECT CASE WHEN LENGTH('${root.login}') > 0 AND LENGTH('${root.senha.hash}') > 0 THEN 1 ELSE 0 END</sqlCheck>
                <sqlCheck expectedResult="1">SELECT COUNT(*) FROM usuarios WHERE login = 'luiz'</sqlCheck>
                <sqlCheck expectedResult="0">SELECT COUNT(*) FROM usuarios WHERE login = '${root.login}'</sqlCheck>
            </and>
        </preConditions>
        <update tableName="usuarios">
            <column name="login" value="${root.login}"/>
            <column name="senha" value="${root.senha.hash}"/>
            <where>login = 'luiz'</where>
        </update>
    </changeSet>

</databaseChangeLog>
